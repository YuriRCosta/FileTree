#!/usr/bin/env python3
"""Refuse a commit whose version sources disagree.

Every value is read from the Git index, never the working tree, so staging
one version while leaving another on disk cannot slip past. Enable with:
git config core.hooksPath tools/hooks
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib

VERSION = re.compile(r"^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$")
RELEASE_BRANCH = re.compile(r"^(\d+\.\d+\.\d+)(?:n|p)?$")
REPORTED = re.compile(r"^fileblade (\S+)$")
HEADING = re.compile(r"^##\s+(.*?)\s*(?:\(unreleased\))?\s*$")


def fail(message):
    print(f"pre-commit: {message}", file=sys.stderr)
    raise SystemExit(1)


def git(*args, **kwargs):
    return subprocess.run(["git", *args], capture_output=True, check=False, **kwargs)


def staged(path, required=True):
    result = git("cat-file", "blob", f":{path}")
    if result.returncode != 0:
        if required:
            fail(f"{path} is not in the index; every version source must be committed together")
        return None
    return result.stdout


def staged_mode(path):
    result = git("ls-files", "--stage", "--", path)
    if result.returncode != 0 or not result.stdout:
        return None
    return result.stdout.split()[0].decode()


def manifest_version(blob):
    try:
        value = json.loads(blob)["version"]
    except (ValueError, KeyError, TypeError):
        fail("manifest.json in the index is not JSON carrying a version")
    if not isinstance(value, str) or not VERSION.match(value):
        fail(f"manifest.json version {value!r} is not a version number")
    return value


def toml_table(blob, path):
    try:
        return tomllib.loads(blob.decode())
    except (ValueError, UnicodeDecodeError) as error:
        fail(f"{path} in the index is not valid TOML: {error}")


def cargo_toml_version(blob):
    package = toml_table(blob, "Cargo.toml").get("package")
    if not isinstance(package, dict) or "version" not in package:
        fail("Cargo.toml has no [package] version of its own")
    value = package["version"]
    if not isinstance(value, str):
        fail("Cargo.toml [package] version is not a string; a workspace inherit cannot be compared")
    return value


def cargo_lock_version(blob):
    packages = toml_table(blob, "Cargo.lock").get("package")
    if not isinstance(packages, list):
        fail("Cargo.lock has no package records")
    records = [p for p in packages if isinstance(p, dict) and p.get("name") == "fileblade"]
    if len(records) != 1:
        fail(f"Cargo.lock names the fileblade package {len(records)} times; expected exactly one")
    if "version" not in records[0]:
        fail("the fileblade record in Cargo.lock has no version of its own")
    return records[0]["version"]


def changelog_version(blob):
    for line in blob.decode(errors="replace").splitlines():
        match = HEADING.match(line)
        if not match:
            continue
        heading = match.group(1).strip()
        if not VERSION.match(heading):
            fail(f"the newest CHANGELOG.md heading {heading!r} names no version")
        return heading
    fail("CHANGELOG.md in the index has no release heading")


def binary_version(blob, mode):
    if mode != "100755":
        fail(f"fileblade-bin is staged with mode {mode}, not 100755, so it would install unexecutable")
    with tempfile.TemporaryDirectory() as directory:
        path = os.path.join(directory, "fileblade-bin")
        with open(path, "wb") as handle:
            handle.write(blob)
        os.chmod(path, 0o700)
        try:
            result = subprocess.run([path, "--version"], capture_output=True, timeout=30, check=False)
        except (OSError, subprocess.SubprocessError) as error:
            fail(f"the staged fileblade-bin could not report its version: {error}")
    if result.returncode != 0:
        fail(f"the staged fileblade-bin exited {result.returncode} for --version")
    match = REPORTED.match(result.stdout.decode(errors="replace").strip())
    if not match:
        fail("the staged fileblade-bin did not answer --version as 'fileblade <version>'")
    return match.group(1)


def main():
    root = git("rev-parse", "--show-toplevel")
    if root.returncode != 0:
        fail("not inside a work tree")
    os.chdir(root.stdout.decode().strip())

    sources = {
        "manifest.json": manifest_version(staged("manifest.json")),
        "Cargo.toml": cargo_toml_version(staged("Cargo.toml")),
        "Cargo.lock": cargo_lock_version(staged("Cargo.lock")),
        "CHANGELOG.md": changelog_version(staged("CHANGELOG.md")),
        "fileblade-bin": binary_version(staged("fileblade-bin"), staged_mode("fileblade-bin")),
    }

    expected = sources["manifest.json"]
    disagreeing = sorted(name for name, value in sources.items() if value != expected)
    if disagreeing:
        print("pre-commit: the staged version sources disagree", file=sys.stderr)
        for name, value in sorted(sources.items()):
            print(f"  {name:<16} {value}", file=sys.stderr)
        raise SystemExit(1)

    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch.returncode == 0:
        match = RELEASE_BRANCH.match(branch.stdout.decode().strip())
        if match and match.group(1) != expected:
            fail(f"branch {branch.stdout.decode().strip()} builds {match.group(1)} but the staged version is {expected}")


main()
