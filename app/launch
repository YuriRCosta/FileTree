#!/usr/bin/env bash
set -euo pipefail

app_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source_dir=$(cd -- "$app_dir/.." && pwd -P)
state_root=${FILEBLADE_SPIKE_HOME:?set FILEBLADE_SPIKE_HOME to an isolated absolute directory for the native spike}

if [[ $state_root != /* || $state_root == / ]]; then
  printf '%s\n' 'fileblade: FILEBLADE_SPIKE_HOME must be an isolated absolute directory' >&2
  exit 2
fi

for dependency in qs hyprctl; do
  if ! command -v "$dependency" >/dev/null; then
    printf 'fileblade: required native capability is unavailable: %s\n' "$dependency" >&2
    exit 127
  fi
done

if [[ ! -x $source_dir/target/release/fileblade ]]; then
  printf '%s\n' 'fileblade: build the local release runtime before launching the spike' >&2
  exit 127
fi

export FILEBLADE_SOURCE_DIR=$source_dir
export FILEBLADE_BINARY=$source_dir/target/release/fileblade
export XDG_CONFIG_HOME=$state_root/config
export XDG_STATE_HOME=$state_root/state
export XDG_DATA_HOME=$state_root/data
mkdir -p -- "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME"
exec qs -n -p "$app_dir" "$@"
