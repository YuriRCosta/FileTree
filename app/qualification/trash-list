#!/usr/bin/env python3
import json
import os
import pathlib
import socket

root = pathlib.Path(os.environ['FILEBLADE_NATIVE_STATE_ROOT'])
if not root.is_absolute():
    raise SystemExit('native state root must be absolute')
with socket.socket(socket.AF_UNIX) as connection:
    connection.settimeout(8)
    connection.connect(str(root / 'authority.sock'))
    reader = connection.makefile('rb')

    def exchange(frame):
        connection.sendall(json.dumps(frame).encode() + b'\n')
        line = reader.readline(8 * 1024 * 1024 + 1)
        if len(line) > 8 * 1024 * 1024 or not line.endswith(b'\n'):
            raise SystemExit('invalid native authority response')
        return json.loads(line)

    hello = exchange({'v': 1, 'type': 'hello'})
    if hello.get('ok') is not True or hello.get('authority') is not True:
        raise SystemExit('native authority unavailable')
    response = exchange({'v': 1, 'type': 'request', 'id': 'expectation-trash',
                         'generation': 1, 'command': 'trash-list', 'arguments': [],
                         'deadline_ms': 5000})
    if response.get('ok') is not True:
        raise SystemExit(response.get('error', 'native Trash query failed'))
    print(json.dumps(response['payload']))
