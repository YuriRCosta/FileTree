#!/usr/bin/env bash
set -euo pipefail
export OVM_HOME=/home/kurt/.local/share/test-omarchy-plugin-a
export OVM_SSH_PORT=2422
ovm=/home/kurt/.claude/skills/test-omarchy-plugin/scripts/ovm
native=/home/omarchy/fileblade-runtime-spike
prelude='export FILEBLADE_APP_ROOT=/home/omarchy/fileblade-runtime-spike FILEBLADE_BINARY=/home/omarchy/fileblade-runtime-spike/target/release/fileblade
export XDG_CONFIG_HOME=/home/omarchy/fileblade-runtime-state/config XDG_STATE_HOME=/home/omarchy/fileblade-runtime-state/state XDG_DATA_HOME=/home/omarchy/fileblade-runtime-state/data FILEBLADE_NATIVE_STATE_ROOT=/home/omarchy/fileblade-runtime-state/state/omarchy/fileblade
omarchy-shell() {
  local args=("$@")
  if [[ ${1:-} == -q ]]; then shift; fi
  case ${1:-} in
    data-goblin.fileblade|data-goblin.fileblade.control) timeout 8 qs ipc -n -p /home/omarchy/fileblade-runtime-spike/app call -- "$@" ;;
    *) command omarchy-shell "${args[@]}" ;;
  esac
}
'
case ${1:-} in
  ipc)
    shift
    case ${1:-} in
      data-goblin.fileblade|data-goblin.fileblade.control)
        printf -v command '%q ' timeout 8 qs ipc -n -p "$native/app" call -- "$@"
        exec "$ovm" ssh "$command"
        ;;
      *) exec "$ovm" ipc "$@" ;;
    esac
    ;;
  ssh)
    shift
    command=$*
    bindings=/home/omarchy/.config/omarchy/plugins/data-goblin.fileblade/examples/fileblade-bindings.lua
    native_bindings="sed 's@omarchy-shell data-goblin.fileblade.control@qs -n -p $native/app ipc call data-goblin.fileblade.control@g' $bindings"
    command=${command//"cat $bindings"/"$native_bindings"}
    command=${command//\/home\/omarchy\/.local\/share\/Trash/\/home\/omarchy\/fileblade-runtime-state\/data\/Trash}
    command=${command//\~\/.local\/share\/Trash/\/home\/omarchy\/fileblade-runtime-state\/data\/Trash}
    exec "$ovm" ssh "$prelude
$command"
    ;;
  restart-shell)
    "$ovm" ssh "timeout 5 qs -p '$native/app' kill || true
for attempt in {1..30}; do
  pgrep -f '^qs -n -p $native/app$' >/dev/null || break
  sleep 0.1
done" >/dev/null
    "$ovm" restart-shell
    exec "$ovm" ssh "setsid env FILEBLADE_SPIKE_HOME=/home/omarchy/fileblade-runtime-state '$native/app/launch' >/tmp/sootscale-native-authority-ui.log 2>&1 </dev/null &"
    ;;
  push|install|reset)
    printf '%s\n' 'fileblade: stage the authorized native spike explicitly before using this expectation adapter' >&2
    exit 2
    ;;
  *) exec "$ovm" "$@" ;;
esac
