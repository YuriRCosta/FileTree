#!/usr/bin/env bash
set -euo pipefail
core_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
probe_path=$(mktemp "$core_root/.rivet-slots.XXXXXX.qml")
probe_log=$(mktemp)
trap 'rm -f -- "$probe_path" "$probe_log"' EXIT
cat > "$probe_path" <<'QML'
import "tests/core_modules" as Core
Core.CoreSlotsProbe {}
QML
probe_status=0
timeout 15 qs -p "$probe_path" > "$probe_log" 2>&1 || probe_status=$?
cat "$probe_log"
test "$probe_status" -eq 0
rg -q 'CORE_SLOTS_PASS' "$probe_log"
if rg -q 'CORE_SLOTS_FAIL' "$probe_log"; then exit 1; fi
